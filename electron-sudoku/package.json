{
  "name": "electron-sudoku",
  "productName": "方寸数独",
  "private": true,
  "version": "0.1.0",
  "description": "使用 Electron、React 和 Vite 构建的桌面数独应用",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names WEB,DESKTOP \"npm:dev:web\" \"npm:dev:desktop:wait\"",
    "dev:web": "vite --host=127.0.0.1 --port=5173 --strictPort",
    "dev:desktop:wait": "wait-on tcp:127.0.0.1:5173 && npm run dev:desktop",
    "dev:desktop": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "preview": "vite preview",
    "test:electron": "cross-env ELECTRON_SMOKE_TEST=1 electron .",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^6.4.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.sudokustudio.desktop",
    "productName": "方寸数独",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
