NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# 默认继续使用 SQLite；以后接入 MySQL 时改为 mysql。
DATABASE_DRIVER=sqlite
DATABASE_PATH=./data/sudoku.sqlite

# MySQL 预留配置。DATABASE_DRIVER=sqlite 时不会建立 MySQL 连接。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sudoku_app
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=sudoku
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false
MYSQL_SSL_CA_PATH=
SESSION_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
TRUST_PROXY=false
